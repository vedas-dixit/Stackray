{
  "name": "@stackray/extension",
  "private": true,
  "version": "0.1.0",
  "description": "Stackray browser extension, built with WXT, for Chrome and Firefox. The Edge build is untested.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "prezip": "pnpm fonts",
    "typecheck": "wxt prepare && tsc -p tsconfig.json",
    "postinstall": "wxt prepare",
    "fonts": "tsx ../../scripts/copy-fonts.ts",
    "predev": "pnpm fonts",
    "pretypecheck": "pnpm fonts",
    "prebuild": "pnpm fonts",
    "prebuild:firefox": "pnpm fonts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@stackray/core": "workspace:*",
    "@stackray/renderer": "workspace:*",
    "@stackray/ui": "workspace:*",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
