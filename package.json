{
  "name": "stackray-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Stackray lifts any web page into a 3D stack of its layers to debug stacking contexts, z-index and clipping.",
  "license": "MIT",
  "author": "Vedas Dixit (https://vedasdixit.com)",
  "homepage": "https://github.com/vedas-dixit/Stackray#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedas-dixit/Stackray.git"
  },
  "bugs": {
    "url": "https://github.com/vedas-dixit/Stackray/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @stackray/viewer dev",
    "dev:ext": "pnpm --filter @stackray/extension dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/capture-fixture.ts",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check . && pnpm typecheck",
    "preview:ui": "pnpm --filter @stackray/viewer e2e",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
